# 用法：
# 复制本文件为 `.env`，按下方说明填入变量。

# 同时开发多个插件时，可以把 Zotero 二进制路径与 profile 路径
# 存进系统环境变量，此文件即可省略。

# Zotero 二进制文件的路径。
# Windows 下路径分隔符需转义为 `\\`。
# macOS 下路径为 `*/Zotero.app/Contents/MacOS/zotero`。
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /path/to/zotero.exe

# 开发用的 profile 路径。
# 运行 `/path/to/zotero.exe -p` 打开 profile 管理器，为开发创建一个 profile。
# @see https://www.zotero.org/support/kb/profile_directory
ZOTERO_PLUGIN_PROFILE_PATH = /path/to/profile

# 数据库所在目录。
# 留空时 Zotero 以默认数据启动。
# @see https://www.zotero.org/support/zotero_data
ZOTERO_PLUGIN_DATA_DIR =

# 自定义结束 Zotero 进程的命令。
# 各平台的内置命令已由 zotero-plugin 提供，
# 内置命令不适用时再修改此变量。
# ZOTERO_PLUGIN_KILL_COMMAND =

# GitHub Token
# 供 scaffold 自动创建 release 并上传附件。
# 仅在本地发布（而非 CI 发布）时填写。
# GITHUB_TOKEN =
